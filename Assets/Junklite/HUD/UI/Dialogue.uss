/* DIALOGUE. Ported from HUD/dialogue/dialogue.css, with no picture. Bottom right, clear of the mod bar: the
   speaker's name chip and unit, the line, and the button prompt. NoBoxes.uss takes the box away; Theme.uss colours it.

   States (toggled by HudDialogue):
     .dlg--open        on screen
     .dlg--typing      the line is still typing out: the prompt says SKIP */

.dlg {
    width: 580px;
    height: 192px;
    opacity: 0;
    translate: 0 18px;
    transition: opacity 280ms ease-out-cubic, translate 280ms ease-out-cubic;
}

.dlg--open { opacity: 1; translate: 0 0; }

/* ---------- the box ---------- */
.dlg-box {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 192px;
    flex-direction: column;
    padding: 16px 26px 14px 26px;
}

.dlg-head { flex-direction: row; align-items: center; height: 30px; }

.dlg-name {
    height: 30px;
    padding: 0 10px;
    flex-shrink: 0;
    -unity-font-definition: var(--hud-title);
    font-size: 24px;
    letter-spacing: 6px;
    color: var(--ink);
    background-color: var(--hot);
    transition: background-color 150ms ease-out;
}

.dlg-name--accent { background-color: var(--action); }
.dlg-head__unit { margin-left: 14px; flex-grow: 1; }


/* the line: Bender is the guideline's dialogue face */
.dlg-line { flex-grow: 1; margin-top: 14px; }

.dlg-text {
    flex-shrink: 1;
    white-space: normal;
    -unity-font-definition: var(--hud-number);
    font-size: 30px;
    letter-spacing: 1.6px;
    color: var(--text);
    -unity-text-align: upper-left;
}

.dlg-foot { flex-direction: row; align-items: center; height: 46px; }

.dlg-foot__count {
    flex-grow: 1;
    -unity-font-definition: var(--hud-number);
    font-size: 14px;
    letter-spacing: 12px;
    color: var(--text-dim);
}

.dlg-foot__label { margin-left: 12px; font-size: 15px; letter-spacing: 22.4px; }

/* while the line types, the prompt is a quiet SKIP; it turns hot (yellow) and pings once the line is out */
.dlg--typing .dlg-foot__kp { opacity: 0.55; }
.dlg--typing .dlg-foot__label { color: var(--text-dim); }
